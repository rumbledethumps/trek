{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "basic",
            "displayName": "basic",
            "description": "BASIC, no compiler",
            "binaryDir": "${sourceDir}/build/basic",
            "cacheVariables": {
                "RP6502_BASIC": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "basic",
            "displayName": "basic",
            "configurePreset": "basic"
        }
    ],
    "testPresets": [
        {
            "name": "basic",
            "displayName": "basic",
            "configurePreset": "basic",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
